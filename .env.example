# Copy this file to .env and fill it in. Git ignores .env.
# The values apply to this project folder only. A variable that is also set in the
# shell takes its value from the shell.

# This project's Anthropic key. It is used instead of a global ANTHROPIC_API_KEY.
CHATCHTG_ANTHROPIC_API_KEY=

CHATCHTG_LLM_PROVIDER=claude
# CHATCHTG_LLM_MODEL=claude-opus-5-5
