# Copy this file to .env and fill it in. Git ignores .env.
# The values apply to this project folder only. A variable that is also set in the
# shell takes its value from the shell.

# This project's Anthropic key. It is used instead of a global ANTHROPIC_API_KEY.
CHATCHTG_ANTHROPIC_API_KEY=

# This project's OpenRouter key. Only the openrouter provider needs it.
CHATCHTG_OPENROUTER_API_KEY=

# claude, openrouter or fake.
CHATCHTG_LLM_PROVIDER=claude
# CHATCHTG_LLM_MODEL=claude-opus-5-5
# With the openrouter provider the default model is moonshotai/kimi-k3.1-pro, and
# requests go only to this OpenRouter provider. Empty: OpenRouter picks one.
# CHATCHTG_OPENROUTER_PROVIDER=modal
# The model that reads the answers when you run `chatchtg eval --judge`.
# CHATCHTG_JUDGE_MODEL=claude-haiku-5-5
# Add the counting conventions of Finnish plans to room-count questions.
# CHATCHTG_COMPOSER=room-conventions
# Answer apartment counts in code when two methods agree (macOS only).
# CHATCHTG_ROOM_COUNTER=confident
